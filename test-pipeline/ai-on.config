// Add-on config: enable AI narration for a test run.
//
//   export ANTHROPIC_API_KEY=sk-ant-...
//   nextflow -c ai-on.config run main.nf
//
// The report then gains an "## AI analysis" section written by Claude from
// the deterministic metrics. Without the key (or on any API failure) the
// run is unaffected and the deterministic report stands alone.
runinsights {
    ai {
        enabled = true
        // model = 'claude-opus-5'   // the default; override if desired
    }
}
